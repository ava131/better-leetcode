{
  "manifest_version": 3,
  "name": "AI 刷题小助手",
  "version": "0.7.2",
  "description": "把题干、你的代码和判题/运行结果自动送进对话，不用再复制粘贴。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.cn/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "src/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "src/markdown.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI 刷题小助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/pet.jpg"
      ],
      "matches": [
        "https://leetcode.cn/*"
      ]
    }
  ]
}
